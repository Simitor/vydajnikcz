---
import '../../styles/global.css';
---
<html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Interní přehled monetizačních metrik Výdajník.cz."/><title>Monetizace — administrace | Výdajník.cz</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body><header class="site-header"><div class="nav-wrap"><a class="brand" href="/"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><a class="nav-cta" href="/">Zpět na web <span>↗</span></a></div></header><main class="wrap admin-page"><div class="eyebrow">INTERNÍ PŘEHLED · POUZE PRO SPRÁVCE</div><h1>Monetizace <span class="serif">v číslech.</span></h1><p class="admin-intro">Přihlaste se tokenem správce. Token se ukládá pouze do této záložky prohlížeče.</p><form class="admin-login"><label>Admin token<input name="token" type="password" autocomplete="current-password" required/></label><button class="button button-primary">Zobrazit přehled <span>↗</span></button><button class="admin-logout" type="button">Odhlásit</button></form><p class="admin-message" aria-live="polite"></p><section class="admin-dashboard" hidden><div class="admin-config"><div class="admin-panel"><h2>Partneři</h2><form data-admin-config data-action="partner"><label>ID slugu<input name="id" placeholder="partner-abc" pattern="[a-z0-9-]+" required/></label><label>Název firmy<input name="name" required/></label><label>Kategorie (oddělené čárkou)<input name="categories" placeholder="car-insurance,energy" required/></label><label>Registr / ověření URL<input name="registrationUrl" type="url"/></label><label>Priorita<input name="priority" type="number" min="0" max="1000" value="10"/></label><label>Webhook secret env klíč<input name="secretRef" placeholder="PARTNER_X_LEAD_URL"/></label><label>Model odměny<input name="payoutModel" placeholder="např. za kvalifikovaný lead"/></label><label><input name="active" type="checkbox"/> Aktivní</label><label><input name="licensed" type="checkbox"/> Ověřený licencovaný distributor</label><button class="button button-primary">Uložit partnera</button><span class="config-message" aria-live="polite"></span></form></div><div class="admin-panel"><h2>Produktová nabídka</h2><form data-admin-config data-action="product"><label>ID produktu<input name="id" required/></label><label>Partner ID<input name="partnerId" required/></label><label>Kategorie<select name="category"><option>car-insurance</option><option>home-insurance</option><option>energy</option><option>mortgage</option><option>loan</option><option>bank-account</option><option>mobile</option><option>internet</option></select></label><label>Název produktu<input name="name" required/></label><label>Cena v Kč<input name="price" type="number" min="0" step="0.01"/></label><label>Období<select name="period"><option value="month">Měsíčně</option><option value="year">Ročně</option><option value="one-off">Jednorázově</option></select></label><label>Partnerská URL<input name="affiliateUrl" type="url" required/></label><label>Podmínky URL<input name="termsUrl" type="url"/></label><label>Spoluúčast<input name="excess"/></label><label><input name="indicative" type="checkbox"/> Cena orientační</label><label><input name="sponsored" type="checkbox"/> Sponzorovaná pozice</label><label><input name="active" type="checkbox"/> Aktivní a veřejná</label><button class="button button-primary">Uložit nabídku</button><span class="config-message" aria-live="polite"></span></form></div><div class="admin-panel"><h2>Reklamní sloty</h2><form data-admin-config data-action="placement"><label>Umístění<select name="placement"><option>top-banner</option><option>between-hero-content</option><option>calculator-middle</option><option>calculator-bottom</option><option>article-inline-1</option><option>article-inline-2</option><option>before-faq</option><option>footer</option><option>sticky-mobile</option></select></label><label>Poskytovatel<select name="provider"><option>adsense</option><option>gam</option><option>custom</option></select></label><label>Slot / ad unit ID<input name="unitId"/></label><label>A/B varianta<input name="variant" value="control"/></label><label><input name="enabled" type="checkbox"/> Zapnout pozici</label><button class="button button-primary">Uložit pozici</button><span class="config-message" aria-live="polite"></span></form></div><div class="admin-panel"><h2>Export kontaktů</h2><p>Export obsahuje osobní údaje. Zacházejte s ním jen podle účelu a oprávnění správce.</p><button class="button button-primary" type="button" data-export-leads>Stáhnout CSV <span>↗</span></button></div></div><div class="admin-panel admin-revenue-import"><h2>Zaúčtovat ověřený report příjmu</h2><p>Vložte údaje z reportu reklamní sítě nebo partnerského vyúčtování. Demo částky nevkládejte.</p><form data-revenue-form><label>Zdroj<select name="sourceType"><option>ads</option><option>affiliate</option><option>lead</option><option>direct</option><option>sponsored</option><option>premium</option></select></label><label>Částka Kč<input name="amount" type="number" min="0" step="0.01" required/></label><label>Datum reportu<input name="occurredAt" type="date" required/></label><label>Reference reportu<input name="reference" required/></label><label>Partner ID<input name="partnerId"/></label><button class="button button-primary">Zaúčtovat příjem</button><span class="config-message" aria-live="polite"></span></form></div><div class="admin-panel admin-ad-import"><h2>Import reklamního výkazu</h2><p>Vložte hodnoty z reportu AdSense / Ad Manager. Výkazy aktualizujte po jednotlivých datech a pozicích.</p><form data-ad-report><label>Datum<input name="date" type="date" required/></label><label>Poskytovatel<select name="provider"><option value="adsense">AdSense</option><option value="gam">Google Ad Manager</option><option value="custom">Jiný</option></select></label><label>Reklamní pozice<input name="placement" value="all" required/></label><label>Zobrazení<input name="impressions" type="number" min="0" step="1" required/></label><label>Kliknutí<input name="clicks" type="number" min="0" step="1" required/></label><label>Příjem Kč<input name="revenue" type="number" min="0" step="0.01" required/></label><label>Reference výkazu<input name="reference" required/></label><button class="button button-primary">Importovat výkaz</button><span class="config-message" aria-live="polite"></span></form></div><div class="admin-kpis"><article><span>Příjmy tento měsíc</span><b data-kpi="month">—</b></article><article><span>Posledních 30 dní</span><b data-kpi="last30">—</b></article><article><span>Příjmy letos</span><b data-kpi="year">—</b></article><article><span>Revenue / 1 000 opt-in návštěv</span><b data-kpi="rpm">—</b></article></div><div class="admin-grid"><article class="admin-panel"><h2>Revenue za 30 dní</h2><div class="admin-bars" data-revenue></div></article><article class="admin-panel"><h2>Reklamy · posledních 30 dní</h2><div class="admin-list-row"><span>Zobrazení z reportů</span><b data-ad-impressions>0</b></div><div class="admin-list-row"><span>Kliknutí z reportů</span><b data-ad-clicks>0</b></div><div class="admin-list-row"><span>CTR</span><b data-ad-ctr>0 %</b></div><div class="admin-list-row"><span>Test variant</span><b data-ad-variants>—</b></div><p class="admin-note">CTR pochází z importovaného výkazu. Varianty jsou počítané z měřených zobrazení po souhlasu.</p></article><article class="admin-panel"><h2>Konverzní události</h2><div class="admin-funnel" data-funnel></div></article><article class="admin-panel"><h2>Leady podle stavu</h2><div data-leads></div></article><article class="admin-panel"><h2>Affiliate prokliky</h2><div data-affiliate></div></article></div><p class="admin-note">Události analytiky a reklam jsou zaznamenány pouze se souhlasem odpovídající kategorie. Revenue musí být naimportováno z ověřených reportů partnerů a reklamních sítí. Nevykázané zdroje se nezobrazují jako skutečný příjem.</p></section></main><script>
	const login=document.querySelector<HTMLFormElement>('.admin-login')!;const msg=document.querySelector<HTMLElement>('.admin-message')!;const dashboard=document.querySelector<HTMLElement>('.admin-dashboard')!;const number=(x:number)=>Math.round(x||0).toLocaleString('cs-CZ')+' Kč';const tokenKey='vydajnik-admin-token';
	const render=async(token:string)=>{const response=await fetch('/api/admin/metrics',{headers:{authorization:`Bearer ${token}`}});const data=await response.json();if(!response.ok)throw new Error(data.error||'Data nelze načíst.');sessionStorage.setItem(tokenKey,token);dashboard.hidden=false;msg.textContent=`Aktualizováno ${new Date(data.generatedAt).toLocaleString('cs-CZ')}`;document.querySelector('[data-kpi=month]')!.textContent=number(data.revenue.month);document.querySelector('[data-kpi=last30]')!.textContent=number(data.revenue.last30);document.querySelector('[data-kpi=year]')!.textContent=number(data.revenue.year);document.querySelector('[data-kpi=rpm]')!.textContent=number(data.revenue.per1000Visitors);const revenue=document.querySelector<HTMLElement>('[data-revenue]')!;revenue.innerHTML=data.sourceRevenue.length?data.sourceRevenue.map((r:{source:string;amount:number})=>`<div class="admin-bar-row"><span>${r.source}</span><i><b style="width:${Math.min(100,Math.max(2,Math.round(r.amount/Math.max(1,...data.sourceRevenue.map((x:{amount:number})=>x.amount))*100)))}%"></b></i><strong>${number(r.amount)}</strong></div>`).join(''):'Zatím nejsou naimportované příjmy.';document.querySelector('[data-ad-impressions]')!.textContent=Number(data.ads.impressions).toLocaleString('cs-CZ');document.querySelector('[data-ad-clicks]')!.textContent=Number(data.ads.clicks).toLocaleString('cs-CZ');document.querySelector('[data-ad-ctr]')!.textContent=Number(data.ads.ctr).toLocaleString('cs-CZ',{maximumFractionDigits:2})+' %';document.querySelector('[data-ad-variants]')!.textContent=data.adVariants.length?data.adVariants.map((v:{placement:string;variant:string;impressions:number})=>v.placement+' · '+v.variant+': '+v.impressions).join(' / '):'Bez A/B měření';const funnel=document.querySelector<HTMLElement>('[data-funnel]')!;funnel.innerHTML=data.funnel.length?data.funnel.map((r:{name:string;count:number})=>`<div>${r.name}<b>${r.count.toLocaleString('cs-CZ')}</b></div>`).join(''):'Zatím nejsou zaznamenané události.';document.querySelector('[data-leads]')!.innerHTML=data.leads.length?data.leads.map((r:{status:string;count:number})=>`<div class="admin-list-row"><span>${r.status}</span><b>${r.count}</b></div>`).join(''):'Bez leadů.';document.querySelector('[data-affiliate]')!.innerHTML=data.affiliate.length?data.affiliate.map((r:{partner_id:string;product_id:string;clicks:number})=>`<div class="admin-list-row"><span>${r.partner_id} / ${r.product_id}</span><b>${r.clicks}</b></div>`).join(''):'Bez prokliků.';};
	login.addEventListener('submit',async(e)=>{e.preventDefault();msg.textContent='Načítám…';try{await render(String(new FormData(login).get('token')))}catch(error){sessionStorage.removeItem(tokenKey);dashboard.hidden=true;msg.textContent=error instanceof Error?error.message:'Přihlášení se nezdařilo.';}});document.querySelector('.admin-logout')?.addEventListener('click',()=>{sessionStorage.removeItem(tokenKey);dashboard.hidden=true;login.reset();msg.textContent='Odhlášeno.';});const cached=sessionStorage.getItem(tokenKey);if(cached)void render(cached).catch(()=>{sessionStorage.removeItem(tokenKey);});
</script></body></html>
