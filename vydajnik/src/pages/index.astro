---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import ProductComparison from '../components/ProductComparison.astro';
import ConsentManager from '../components/ConsentManager.astro';
import Analytics from '../components/Analytics.astro';

const calculators = [
  { id: 'prijem', number: '01', title: 'Mzda nebo podnikání?', description: 'Porovnejte zaměstnání, OSVČ a paušální daň na jednom místě.', tag: 'Příjmy', icon: '↗' },
  { id: 'auto', number: '02', title: 'Kolik stojí vaše auto?', description: 'Odhalte skutečnou cenu každého kilometru včetně servisu a ztráty hodnoty.', tag: 'Doprava', icon: '↗' },
  { id: 'energie', number: '03', title: 'Energie a bydlení', description: 'Zjistěte, kam mizí peníze za provoz domácnosti.', tag: 'Připravujeme', icon: '↗' },
  { id: 'bydleni', number: '04', title: 'Nájem, nebo hypotéka?', description: 'Porovnejte náklady na vlastní bydlení a nájem v čase.', tag: 'Připravujeme', icon: '↗' },
];
const faq = [
  ['Jsou výsledky závazné?', 'Ne. Výsledky jsou orientační a slouží k základnímu přehledu. Nenahrazují daňové, právní ani finanční poradenství.'],
  ['Posíláte moje údaje na server?', 'Výpočty probíhají přímo ve vašem prohlížeči. Zadané hodnoty se nikam neposílají, pokud se sami nerozhodnete odeslat kontaktní formulář.'],
  ['Z jakých hodnot kalkulačky vycházejí?', 'Daňová kalkulačka používá zjednodušený model pro rok 2026. U každé kalkulačky uvádíme hlavní předpoklady; před důležitým rozhodnutím ověřte konkrétní situaci s odborníkem.'],
];
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Spočítejte si, kolik vás stojí práce a auto. Přehledné české kalkulačky s okamžitým výpočtem přímo ve vašem prohlížeči." />
		<meta name="theme-color" content="#f7f8fa" />
		<meta property="og:title" content="Výdajník.cz — Život v číslech" />
		<meta property="og:description" content="Mějte jasno v tom, kam vaše peníze skutečně odcházejí." />
		<meta property="og:type" content="website" />
		<title>Výdajník.cz — Život v číslech</title>
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Výdajník.cz', applicationCategory: 'FinanceApplication', operatingSystem: 'Any', inLanguage: 'cs', description: 'České kalkulačky životních nákladů.' })} />
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />
	</head>
	<body>
		<header class="site-header">
			<div class="nav-wrap">
				<a class="brand" href="#top" aria-label="Výdajník.cz — úvod"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a>
				<button class="menu-toggle" aria-label="Otevřít navigaci" aria-expanded="false"><span></span><span></span></button>
				<nav class="main-nav" aria-label="Hlavní navigace"><a href="#kalkulacky">Kalkulačky</a><a href="#jak-to-funguje">Jak to funguje</a><a href="#o-nas">O Výdajníku</a><a href="#faq">Časté otázky</a></nav>
				<a class="nav-cta" href="#kalkulacky">Spočítat náklady <span>↗</span></a>
			</div>
		</header>
		<div class="wrap"><AdSlot placement="top-banner" /></div><main id="top">
			<section class="hero wrap">
				<div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> FINANČNÍ JASNOST, KONEČNĚ</div>
					<h1>Život něco stojí.<br /><span class="serif">Zjistěte kolik.</span></h1>
					<p class="hero-lead">Práce, auto, bydlení. Spočítejte si skutečné náklady — přehledně, bez složitostí a za pár vteřin.</p>
					<div class="hero-actions"><a class="button button-primary" href="#kalkulacky">Vybrat kalkulačku <span>↓</span></a><a class="text-link" href="#jak-to-funguje">Jak to funguje <span>↗</span></a></div>
					<div class="hero-proof"><div class="proof-avatars"><i>✓</i><i>✓</i><i>✓</i></div><span>Výpočet probíhá ve vašem prohlížeči.<br /><b>Vaše čísla zůstávají vaše.</b></span></div>
				</div>
				<div class="hero-visual" aria-label="Ukázka přehledu nákladů"><div class="visual-grid"></div><div class="visual-label">MĚSÍČNÍ PŘEHLED <span>2026</span></div><div class="visual-total"><span>Skutečné náklady na auto</span><b>12 480 <small>Kč / měs.</small></b><em>↓ 1 280 Kč oproti průměru</em></div><div class="visual-chart"><div class="chart-y"><span>15k</span><span>10k</span><span>5k</span><span>0</span></div><div class="bars"><i style="--h:42%"></i><i style="--h:56%"></i><i style="--h:48%"></i><i style="--h:71%"></i><i style="--h:62%"></i><i style="--h:84%"></i><i style="--h:69%"></i><i style="--h:52%"></i><i style="--h:77%"></i><i style="--h:59%"></i><i style="--h:91%"></i><i style="--h:68%"></i></div></div><div class="visual-months"><span>LED</span><span>BŘE</span><span>DUB</span><span>KVĚ</span><span>ČVN</span><span>ČVC</span><span>SRP</span><span>ZÁŘ</span><span>ŘÍJ</span><span>LIST</span><span>PRO</span></div><div class="visual-legend"><span><i></i> Náklady v čase</span><span>↗ 12 měsíců</span></div><div class="float-note"><span>✓</span> Data zůstávají u vás</div></div>
				<div class="hero-index">01 <span>—</span> 02</div>
			</section>
			<section class="trust-strip"><div class="wrap trust-inner"><span>JASNÁ ČÍSLA. LEPŠÍ ROZHODNUTÍ.</span><div><i>◈</i> Bez registrace</div><div><i>◴</i> Výsledek hned</div><div><i>⌑</i> Soukromí na prvním místě</div><div><i>◎</i> Aktualizováno pro 2026</div></div></section>
			<div class="wrap"><AdSlot placement="between-hero-content" /></div><section id="kalkulacky" class="section wrap calculators-section"><div class="section-heading"><div><div class="eyebrow">VAŠE PENÍZE, V KONTEXTU</div><h2>Co chcete <span class="serif">spočítat?</span></h2></div><a class="subtle-link" href="#kalkulacky">Prozkoumat kalkulačky <span>↗</span></a></div>
				<div class="calculator-grid">{calculators.map((item) => <a href={item.id === 'prijem' ? '/kalkulacka-ciste-mzdy/' : item.id === 'auto' ? '/naklady-na-auto/' : '#kalkulacky'} class:list={['calculator-card', item.id === 'prijem' && 'featured', item.tag === 'Připravujeme' && 'coming-soon']} data-calc={item.id}><div class="card-top"><span class="card-number">{item.number}</span><span class="card-tag">{item.tag}</span></div><div class="card-icon">{item.icon}</div><h3>{item.title}</h3><p>{item.description}</p><span class="card-bottom">{item.tag === 'Připravujeme' ? 'Již brzy' : 'Otevřít kalkulačku'} <b>↗</b></span></a>)}</div>
			</section>
			<section id="calculator" class="calculator-section"><div class="wrap"><div class="section-heading calc-heading"><div><div class="eyebrow">OKAMŽITÝ VÝPOČET · BEZ REGISTRACE</div><h2>Kalkulačka <span class="serif">nákladů</span></h2></div><span class="updated-pill"><i></i> Model 2026</span></div>
				<div class="calc-tabs" role="tablist"><button class="calc-tab active" data-tab="income" role="tab" aria-selected="true"><span>01</span> Mzda vs. OSVČ</button><button class="calc-tab" data-tab="car" role="tab" aria-selected="false"><span>02</span> Náklady na auto</button></div>
				<div class="calc-layout"><div class="calc-controls">
					<div class="calc-panel active" id="panel-income"><div class="panel-intro"><h3>Porovnejte svůj příjem</h3><p>Upravte částku a způsob práce. Výsledky se přepočítají okamžitě.</p></div><label class="field-label" for="income-amount">Měsíční hrubý příjem <span>v Kč</span></label><div class="input-wrap"><input id="income-amount" type="number" min="15000" max="500000" step="1000" value="65000" inputmode="numeric"/><span>Kč / měs.</span></div><input class="range" id="income-range" type="range" min="15000" max="200000" step="1000" value="65000" aria-label="Měsíční hrubý příjem"/><div class="range-labels"><span>15 000 Kč</span><span>200 000 Kč</span></div><div class="divider"></div><label class="field-label" for="expense-rate">Výdajový paušál OSVČ</label><select id="expense-rate" class="select-input"><option value="0.6" selected>60 % — živnostenské podnikání</option><option value="0.8">80 % — řemeslná živnost</option><option value="0.4">40 % — svobodné povolání</option></select><label class="check-row"><input id="taxpayer-discount" type="checkbox" checked/><span class="custom-check">✓</span><span>Uplatňuji základní slevu na poplatníka</span></label><div class="assumption-note"><span>ⓘ</span><span>Zjednodušený model pro hlavní činnost, bez dětí a dalších odpočtů. Paušální daň je odhad I. pásma.</span></div></div>
					<div class="calc-panel" id="panel-car"><div class="panel-intro"><h3>Spočítejte cenu každého kilometru</h3><p>Palivo je jen začátek. Přidejte nájezd i náklady, které běžně zůstávají skryté.</p></div><label class="field-label" for="km-year">Roční nájezd <span>kilometrů</span></label><div class="input-wrap"><input id="km-year" type="number" min="1000" max="80000" step="500" value="15000" inputmode="numeric"/><span>km / rok</span></div><input class="range" id="km-range" type="range" min="1000" max="50000" step="500" value="15000" aria-label="Roční nájezd"/><div class="range-labels"><span>1 000 km</span><span>50 000 km</span></div><div class="divider"></div><div class="two-fields"><div><label class="field-label" for="consumption">Spotřeba</label><div class="input-wrap compact"><input id="consumption" type="number" min="3" max="25" step="0.1" value="6.8"/><span>l / 100 km</span></div></div><div><label class="field-label" for="fuel-price">Cena paliva</label><div class="input-wrap compact"><input id="fuel-price" type="number" min="20" max="70" step="0.5" value="38.5"/><span>Kč / l</span></div></div></div><details class="extra-costs"><summary>Upravit další roční náklady <span>＋</span></summary><div class="cost-inputs"><label>Servis a opravy <div class="input-wrap compact"><input id="service" type="number" value="18000" min="0" step="1000"/><span>Kč / rok</span></div></label><label>Pojištění a známka <div class="input-wrap compact"><input id="insurance" type="number" value="14500" min="0" step="500"/><span>Kč / rok</span></div></label><label>Amortizace <div class="input-wrap compact"><input id="depreciation" type="number" value="42000" min="0" step="1000"/><span>Kč / rok</span></div></label></div></details><div class="assumption-note"><span>ⓘ</span><span>Upravte předvyplněné odhady podle svého auta. Náklady jsou orientační.</span></div></div>
					<div class="calc-footnote"><span>🔒</span> Výpočet probíhá bezpečně ve vašem zařízení.</div></div>
					<div class="results-card"><div class="result-top"><div><span class="result-kicker" id="result-kicker">VÁŠ ČISTÝ MĚSÍČNÍ PŘÍJEM</span><div class="result-main" id="result-main">49 265 <small>Kč</small></div></div><button class="period-toggle" aria-label="Zobrazit měsíční nebo roční částky"><span class="selected">Měsíčně</span><span>Ročně</span></button></div><div class="result-caption" id="result-caption">Kolik vám přibližně zůstane jako zaměstnanci.</div><div class="result-compare" id="result-compare"></div><div class="result-details" id="result-details"></div><div class="chart-wrap"><div class="chart-title"><b>Kam peníze odcházejí</b><span id="chart-caption">měsíční pohled</span></div><div class="mini-chart" id="mini-chart"></div><div class="chart-legend" id="chart-legend"></div></div><div class="savings-box"><span class="savings-icon">↗</span><div><b id="savings-title">Rozdíly, které stojí za pozornost</b><p id="savings-text">Porovnejte varianty a zjistěte, co dává smysl právě pro vás.</p></div></div><button class="report-button" id="report-button">Vytisknout finanční přehled <span>↗</span></button><p class="result-disclaimer">Orientační výpočet, který nenahrazuje daňové ani finanční poradenství.</p></div>
				</div>
			</div></section>
			<div class="wrap monetization-break" data-monetization-for="auto" hidden><ProductComparison category="car-insurance" calculator="auto" title="Uvažujete o nižších nákladech na auto?" /><AdSlot placement="calculator-bottom" /></div><section id="jak-to-funguje" class="how-section wrap"><div class="how-copy"><div class="eyebrow">ŽÁDNÁ VĚDA. JEN JASNOST.</div><h2>Tři kroky k lepšímu <span class="serif">přehledu.</span></h2><p>Dobré finanční rozhodnutí začíná tím, že znáte skutečná čísla. My vám je pomůžeme najít.</p><a href="#kalkulacky" class="text-link">Pustit se do toho <span>↗</span></a></div><div class="steps"><article><span>01</span><div><h3>Vyberete situaci</h3><p>Zvolte kalkulačku, která odpovídá tomu, co právě řešíte.</p></div><i>↘</i></article><article><span>02</span><div><h3>Dosadíte svá čísla</h3><p>Jednoduše upravte hodnoty. Výsledek vidíte hned, bez čekání.</p></div><i>↘</i></article><article><span>03</span><div><h3>Rozhodnete se s přehledem</h3><p>Porovnejte varianty a udělejte další krok s větší jistotou.</p></div><i>✓</i></article></div></section>
			<section class="privacy-band" id="o-nas"><div class="wrap privacy-content"><div class="privacy-mark">⌑</div><div><div class="eyebrow">VAŠE SOUKROMÍ BEREME VÁŽNĚ</div><h2>Vaše čísla. <span class="serif">Vaše věc.</span></h2><p>Kalkulace se odehrává přímo ve vašem prohlížeči. Bez účtu, bez ukládání citlivých údajů a bez překvapení.</p></div><a class="button button-light" href="#kalkulacky">Vyzkoušet kalkulačku <span>↗</span></a></div></section>
			<section id="faq" class="faq-section wrap"><div><div class="eyebrow">DOBRÉ VĚDĚT</div><h2>Časté <span class="serif">otázky.</span></h2></div><div class="faq-list">{faq.map(([q, a]) => <details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div></section>
		</main>
		<AdSlot placement="footer" /><AdSlot placement="sticky-mobile" /><footer class="site-footer"><div class="wrap footer-main"><a class="brand footer-brand" href="#top"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><p>Pomáháme vidět skutečná čísla za každodenními rozhodnutími.</p><div class="footer-links"><a href="#kalkulacky">Kalkulačky</a><a href="/inzerce/">Inzerce a spolupráce</a><a href="/pojisteni-auto/">Pojištění auta</a><a href="/ochrana-soukromi/">Ochrana soukromí</a></div></div><div class="wrap footer-bottom" id="footer-legal"><span>© 2026 Výdajník.cz</span><span>Tento portál provozuje nezávislé informační kalkulačky. Výpočty mají orientační charakter a nepředstavují finanční poradenství ani závaznou nabídku.</span><span>Česko <i>✳</i></span></div></footer>
		<script>
			const byId = (id) => document.getElementById(id);
			const money = (n) => Math.round(n).toLocaleString('cs-CZ');
			const clamp = (n, min, max) => Math.min(max, Math.max(min, Number(n) || min));
			const state = { tab: 'income', annual: false };
			const fmt = (n) => `${money(n)} Kč`;
			function incomeResults() {
				const monthly = clamp(byId('income-amount').value, 15000, 200000), annual = monthly * 12;
				const discount = byId('taxpayer-discount').checked ? 30840 : 0;
				const wageSocial = Math.round(annual * .071), wageHealth = Math.round(annual * .045);
				const wageTax = Math.max(0, Math.round(annual * .15) - discount);
				const wageNet = annual - wageSocial - wageHealth - wageTax;
				const rate = Number(byId('expense-rate').value), base = Math.max(0, annual * (1-rate));
				const social = Math.max(64350, Math.round(base * .55 * .292));
				const health = Math.max(39672, Math.round(base * .5 * .135));
				const tax = Math.max(0, Math.round(base * .15) - discount);
				const selfNet = annual - social - health - tax;
				const flatTax = 9162 * 12; // I. pásmo podle aktuální hodnoty pro rok 2026
				const flatNet = annual - flatTax;
				return [
					{ label: 'Zaměstnanec', short: 'Zaměstnanec', net: wageNet, tax: wageTax, social: wageSocial, health: wageHealth, color: '#2864dc' },
					{ label: 'OSVČ · výdajový paušál', short: 'OSVČ', net: selfNet, tax, social, health, color: '#20a783' },
					{ label: 'Paušální daň · I. pásmo', short: 'Paušální daň', net: flatNet, tax: 0, social: 0, health: 0, flatTax, color: '#e3a545' },
				];
			}
			function carResults() {
				const km = clamp(byId('km-year').value, 1000, 50000), consumption = clamp(byId('consumption').value, 3, 25), fuelPrice = clamp(byId('fuel-price').value, 20, 70);
				const fuel = km * consumption / 100 * fuelPrice;
				const service = clamp(byId('service').value, 0, 100000), insurance = clamp(byId('insurance').value, 0, 100000), depreciation = clamp(byId('depreciation').value, 0, 300000);
				const costs = [{label:'Palivo', amount:fuel, color:'#2864dc'}, {label:'Servis a opravy', amount:service, color:'#20a783'}, {label:'Pojištění a známka', amount:insurance, color:'#e3a545'}, {label:'Amortizace', amount:depreciation, color:'#8b78d5'}];
				return { km, costs, total: costs.reduce((sum, item) => sum + item.amount, 0) };
			}
			function draw() {
				const result = byId('result-main'), compare = byId('result-compare'), details = byId('result-details'), bars = byId('mini-chart'), legend = byId('chart-legend');
				const divisor = state.annual ? 1 : 12;
				byId('chart-caption').textContent = state.annual ? 'roční pohled' : 'měsíční pohled';
				if (state.tab === 'income') {
					const entries = incomeResults(), wage = entries[0], best = entries.reduce((a,b)=>a.net>b.net?a:b);
					byId('result-kicker').textContent = state.annual ? 'VÁŠ ČISTÝ ROČNÍ PŘÍJEM' : 'VÁŠ ČISTÝ MĚSÍČNÍ PŘÍJEM';
					byId('result-caption').textContent = 'Zaměstnanec · po odvodech a základní slevě';
					result.innerHTML = `${money(wage.net/divisor)} <small>Kč</small>`;
					compare.innerHTML = entries.map(e => `<div class="compare-item ${e.short === best.short ? 'compare-best' : ''}"><span><i style="--dot:${e.color}"></i>${e.short}</span><b>${money(e.net/divisor)} Kč</b></div>`).join('');
					details.innerHTML = `<div><span>Daň z příjmů</span><b>${fmt(wage.tax/divisor)}</b></div><div><span>Sociální pojištění</span><b>${fmt(wage.social/divisor)}</b></div><div><span>Zdravotní pojištění</span><b>${fmt(wage.health/divisor)}</b></div><div class="details-total"><span>Celkem odvody</span><b>${fmt((wage.tax+wage.social+wage.health)/divisor)}</b></div>`;
					const data=[{label:'Čistý příjem',value:wage.net,color:'#2864dc'},{label:'Odvody',value:wage.tax+wage.social+wage.health,color:'#dce5f3'}];
					byId('savings-title').textContent = best.short === wage.short ? 'Zaměstnání vychází nejlépe' : `${best.short} může vycházet lépe`;
					byId('savings-text').textContent = `${best.short} přináší v tomto modelu rozdíl ${fmt(Math.abs(best.net-wage.net)/divisor)} ${state.annual ? 'ročně' : 'měsíčně'} oproti zaměstnání. Započítejte také dovolenou, nemocenskou a náklady podnikání.`;
				} else {
					const car=carResults();
					byId('result-kicker').textContent = 'SKUTEČNÁ CENA JEDNOHO KILOMETRU';
					byId('result-caption').textContent = `Při ročním nájezdu ${money(car.km)} km`;
					result.innerHTML = `${(car.total/car.km).toLocaleString('cs-CZ',{minimumFractionDigits:2,maximumFractionDigits:2})} <small>Kč / km</small>`;
					compare.innerHTML = `<div class="compare-item compare-best"><span><i style="--dot:#2864dc"></i>Celkem ročně</span><b>${fmt(car.total)}</b></div><div class="compare-item"><span><i style="--dot:#20a783"></i>Průměrně měsíčně</span><b>${fmt(car.total/12)}</b></div>`;
					details.innerHTML = car.costs.map(c=>`<div><span>${c.label}</span><b>${fmt(c.amount/divisor)}</b></div>`).join('')+`<div class="details-total"><span>Celkem ${state.annual?'ročně':'měsíčně'}</span><b>${fmt(car.total/divisor)}</b></div>`;
					byId('savings-title').textContent = 'Palivo není celý příběh';
					byId('savings-text').textContent = `Celkové náklady vycházejí na ${fmt(car.total/divisor)} ${state.annual?'ročně':'měsíčně'}. Servis, pojištění a pokles hodnoty tvoří ${Math.round((car.total-car.costs[0].amount)/car.total*100)} % celku.`;
					const data=car.costs;
				}
				const data= state.tab === 'income' ? [{label:'Čistý příjem',value:incomeResults()[0].net,color:'#2864dc'},{label:'Odvody',value:incomeResults()[0].tax+incomeResults()[0].social+incomeResults()[0].health,color:'#dce5f3'}] : carResults().costs;
				bars.innerHTML = data.map(d=>`<span title="${d.label}: ${fmt(d.value/divisor)}" style="height:${Math.max(8,d.value/Math.max(...data.map(x=>x.value))*100)}%;background:${d.color}"></span>`).join('');
				legend.innerHTML = data.map(d=>`<span><i style="--dot:${d.color}"></i>${d.label}</span>`).join('');
			}
			function activate(tab) {
				state.tab=tab;
				document.querySelectorAll('.calc-tab').forEach(b=>{const active=b.dataset.tab===(tab==='income'?'income':'car');b.classList.toggle('active',active);b.setAttribute('aria-selected',String(active));});
				document.querySelectorAll('.calc-panel').forEach(p=>p.classList.toggle('active',p.id===(tab==='income'?'panel-income':'panel-car')));
				draw();
				const relevantOffers=document.querySelector('[data-monetization-for="auto"]'); if(relevantOffers) relevantOffers.hidden=tab!=='car';
			}
			document.querySelectorAll('.calc-tab').forEach(b=>b.addEventListener('click',()=>activate(b.dataset.tab)));
			function pair(inputId, rangeId) { const input=byId(inputId), range=byId(rangeId); input.addEventListener('input',()=>{range.value=input.value;draw();}); range.addEventListener('input',()=>{input.value=range.value;draw();}); }
			pair('income-amount','income-range'); pair('km-year','km-range');
			['expense-rate','taxpayer-discount','consumption','fuel-price','service','insurance','depreciation'].forEach(id=>byId(id).addEventListener('input',draw));
			byId('report-button').addEventListener('click',()=>window.print());
			document.querySelector('.period-toggle').addEventListener('click',(event)=>{state.annual=!state.annual;event.currentTarget.querySelectorAll('span').forEach((e,i)=>e.classList.toggle('selected',i===(state.annual?1:0)));draw();});
			document.querySelectorAll('.calculator-card').forEach(c=>c.addEventListener('click',()=>{if(c.dataset.calc==='prijem'||c.dataset.calc==='auto'){setTimeout(()=>activate(c.dataset.calc==='auto'?'car':'income'),0);}}));
			const menu=document.querySelector('.menu-toggle');menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('.main-nav').classList.toggle('nav-open',open);});
			document.querySelectorAll('.main-nav a').forEach(a=>a.addEventListener('click',()=>{menu.setAttribute('aria-expanded','false');document.querySelector('.main-nav').classList.remove('nav-open');}));
			draw();
			const requestedCalculator = new URLSearchParams(window.location.search).get('kalkulacka');
			if (requestedCalculator === 'auto' || requestedCalculator === 'income') activate(requestedCalculator);
		</script>
	<ConsentManager /><Analytics /></body>
</html>
