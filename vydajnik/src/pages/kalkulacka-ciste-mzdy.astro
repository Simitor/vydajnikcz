---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import ProductComparison from '../components/ProductComparison.astro';
import ConsentManager from '../components/ConsentManager.astro';
import Analytics from '../components/Analytics.astro';
const questions = [
  ['Jak kalkulačka počítá čistou mzdu?', 'Z hrubého příjmu odečítá orientační sociální a zdravotní pojištění zaměstnance a daň z příjmů po základní slevě na poplatníka. Jde o zjednodušený model pro rok 2026.'],
  ['Jak kalkulačka počítá OSVČ?', 'Model uplatňuje zvolený výdajový paušál, daň z příjmů po základní slevě a minimální odvody hlavní samostatné činnosti. Nezahrnuje individuální odpočty ani další slevy.'],
  ['Je paušální daň výhodnější?', 'Záleží na výši příjmů, druhu činnosti, nároku na slevy i skutečných výdajích. Kalkulačka nabízí srovnávací orientaci, nikoli doporučení vhodného režimu.'],
];
---
<html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Porovnejte čistou mzdu zaměstnance s příjmem OSVČ a paušální daní. Orientační kalkulačka pro rok 2026 počítá okamžitě."/><title>Kalkulačka čisté mzdy a OSVČ 2026 | Výdajník.cz</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'SoftwareApplication',name:'Kalkulačka mzdy a OSVČ | Výdajník.cz',applicationCategory:'FinanceApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'CZK'}})}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:questions.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))})}/></head><body><header class="site-header"><div class="nav-wrap"><a class="brand" href="/"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><nav class="main-nav"><a href="/#kalkulacky">Kalkulačky</a><a href="/#jak-to-funguje">Jak to funguje</a><a href="/#o-nas">O Výdajníku</a></nav><a class="nav-cta" href="/?kalkulacka=income#calculator">Spočítat příjem <span>↗</span></a></div></header><main><section class="seo-hero wrap"><div class="eyebrow">KALKULAČKA PŘÍJMŮ · AKTUALIZOVÁNO PRO 2026</div><h1>Kolik vám skutečně <span class="serif">zůstane?</span></h1><p class="hero-lead">Porovnejte zaměstnání, podnikání na IČO a paušální daň. Zadejte svůj měsíční příjem a uvidíte orientační čistý výsledek i odvody.</p><a class="button button-primary" href="/?kalkulacka=income#calculator">Otevřít kalkulačku <span>↗</span></a><div class="seo-stats"><div><b>3 varianty</b><span>na jednom místě</span></div><div><b>Výpočet hned</b><span>bez registrace</span></div><div><b>Rok 2026</b><span>orientační model</span></div></div></section><section class="seo-content wrap"><article><div class="eyebrow">JAK VÝPOČET FUNGUJE</div><h2>Mzda a podnikání <span class="serif">vedle sebe.</span></h2><p>Hrubá mzda není totéž co částka, která každý měsíc dorazí na účet. Rozdíly mezi zaměstnáním a samostatnou činností vznikají nejen kvůli dani, ale také kvůli sociálnímu a zdravotnímu pojištění, výdajům a režimu podnikání.</p><p>Kalkulačka porovná zadaný měsíční příjem ve třech modelech. U zaměstnance odečte orientační odvody a základní slevu na poplatníka. U OSVČ zohlední zvolený výdajový paušál a minimální pojistné pro hlavní činnost. Paušální režim vychází z I. pásma.</p><div class="method-callout"><b>Co výsledek neobsahuje</b><p>Děti, další daňové slevy a odpočty, nemocenské pojištění OSVČ, skutečné provozní náklady, dovolenou ani hodnotu zaměstnaneckých benefitů.</p></div><h2>Na co myslet při <span class="serif">porovnání.</span></h2><p>Částka fakturovaná na IČO není přímo srovnatelná s hrubou mzdou. Podnikatel si z ní hradí vlastní vybavení, účetnictví, neplacenou dovolenou i období bez zakázek. Zaměstnání zase může zahrnovat benefity a ochranu, které jednoduchý výpočet v korunách nezachytí.</p><p>Částky zákonných odvodů se mohou v průběhu roku měnit a záleží také na individuálních podmínkách poplatníka. Ověřte proto konkrétní výpočet u účetní nebo daňového poradce.</p><div class="source-note">Metodika: zjednodušený model Výdajník.cz · Informativní hodnoty pro rok 2026 · Aktualizováno 29. 9. 2026.</div></article><aside class="seo-aside"><span class="aside-icon">↗</span><h3>Vaše čistá mzda na pár kliknutí.</h3><p>Upravte příjem a výdajový paušál. Výsledky se přepočítají přímo ve vašem zařízení.</p><a href="/?kalkulacka=income#calculator">Spočítat příjem <b>→</b></a></aside></section><div class="wrap"><AdSlot placement="article-inline-1" /><ProductComparison category="car-insurance" calculator="auto" /><AdSlot placement="before-faq" /></div><section class="seo-faq"><div class="wrap"><div class="eyebrow">DOBRÉ VĚDĚT</div><h2>Časté otázky</h2><div class="faq-list">{questions.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div><a class="text-link" href="/naklady-na-auto/">Další kalkulačka: skutečné náklady na auto <span>↗</span></a></div></section></main><footer class="site-footer"><div class="wrap footer-main"><a class="brand footer-brand" href="/"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><p>Pomáháme vidět skutečná čísla za každodenními rozhodnutími.</p><div class="footer-links"><a href="/naklady-na-auto/">Náklady na auto</a><a href="/#o-nas">O projektu</a><a href="/#faq">Soukromí</a></div></div><div class="wrap footer-bottom"><span>© 2026 Výdajník.cz</span><span>Orientační výpočty nepředstavují finanční poradenství.</span><span>Česko <i>✳</i></span></div></footer><ConsentManager /><Analytics /><AdSlot placement="sticky-mobile"/><AdSlot placement="footer"/></body></html>
