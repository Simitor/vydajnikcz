---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import ProductComparison from '../components/ProductComparison.astro';
import ConsentManager from '../components/ConsentManager.astro';
import Analytics from '../components/Analytics.astro';
const questions = [
  ['Jak se vypočítá cena kilometru?', 'Roční odhad paliva, servisu, pojištění a amortizace se sečte a vydělí ročním nájezdem. Výsledná částka je orientační a závisí na vašich vstupech.'],
  ['Proč započítávat amortizaci?', 'Vozidlo obvykle postupně ztrácí hodnotu. Zahrnutí odhadu poklesu ceny pomáhá ukázat širší náklady na vlastnictví než samotné tankování.'],
  ['Obsahuje výpočet parkování a mytí?', 'Ne. Můžete si je přičíst do pole servis a opravy. Kalkulačka zatím samostatně nerozlišuje parkování, mytí ani financování auta.'],
];
---
<html lang="cs"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Spočítejte skutečné náklady na auto: palivo, servis, pojištění i amortizaci. Zjistěte cenu kilometru a roční výdaje."/><title>Náklady na auto: cena kilometru | Výdajník.cz</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'SoftwareApplication',name:'Kalkulačka nákladů na auto | Výdajník.cz',applicationCategory:'FinanceApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'CZK'}})}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:questions.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))})}/></head><body><header class="site-header"><div class="nav-wrap"><a class="brand" href="/"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><nav class="main-nav"><a href="/#kalkulacky">Kalkulačky</a><a href="/#jak-to-funguje">Jak to funguje</a><a href="/#o-nas">O Výdajníku</a></nav><a class="nav-cta" href="/?kalkulacka=auto#calculator">Spočítat náklady <span>↗</span></a></div></header><main><section class="seo-hero wrap"><div class="eyebrow">KALKULAČKA NÁKLADŮ NA AUTO</div><h1>Kolik stojí každý <span class="serif">kilometr?</span></h1><p class="hero-lead">Cena auta není jen to, co zaplatíte na pumpě. Přidejte servis, pojištění a ztrátu hodnoty — a zjistěte, kolik vás vůz opravdu stojí.</p><a class="button button-primary" href="/?kalkulacka=auto#calculator">Spočítat cenu kilometru <span>↗</span></a><div class="seo-stats"><div><b>Palivo</b><span>spotřeba × cena</span></div><div><b>Vlastnictví</b><span>servis a pojištění</span></div><div><b>Amortizace</b><span>pokles hodnoty vozu</span></div></div></section><section class="seo-content wrap"><article><div class="eyebrow">SKUTEČNÉ NÁKLADY NA PROVOZ</div><h2>Auto stojí víc než <span class="serif">tankování.</span></h2><p>Část výdajů za auto vidíte pokaždé, když zastavíte u čerpací stanice. Další se objeví až při výměně pneumatik, servisu nebo roční platbě pojištění. A vedle nich je tu také hodnota, kterou vůz postupně ztrácí.</p><p>Kalkulačka sčítá spotřebu paliva podle vašeho ročního nájezdu, cenu paliva a odhady na servis, pojištění a amortizaci. Z celkových ročních nákladů vypočítá průměrnou měsíční částku i cenu jednoho kilometru.</p><div class="method-callout"><b>Vstupy můžete přizpůsobit svému vozu</b><p>Změňte roční nájezd, spotřebu a cenu paliva. Rozbalte další náklady a nahraďte předvyplněné odhady vlastními částkami.</p></div><h2>Porovnávejte <span class="serif">celý obrázek.</span></h2><p>Nižší spotřeba pomáhá omezit náklady na palivo, ale celkovou cenu ovlivňuje i počet najetých kilometrů, stav auta, způsob financování a jeho budoucí prodejní cena. Výsledek kalkulačky proto berte jako přehlednou orientaci, ne jako univerzální cenu pro každý vůz.</p><p>Kalkulačka zatím nezahrnuje parkování, mytí, úroky z financování ani případné výdaje za dálniční známku odděleně. Tyto položky můžete přičíst k vlastním ročním nákladům.</p><div class="source-note">Metodika: roční součet vstupních nákladů dělený nájezdem · Orientační model Výdajník.cz · Aktualizováno 29. 9. 2026.</div></article><aside class="seo-aside"><span class="aside-icon">↗</span><h3>Palivo je jen začátek.</h3><p>Zadejte svůj nájezd, spotřebu a další výdaje. Uvidíte skutečnou cenu každého kilometru.</p><a href="/?kalkulacka=auto#calculator">Spočítat náklady <b>→</b></a></aside></section><div class="wrap"><AdSlot placement="article-inline-1" /><ProductComparison category="car-insurance" calculator="auto" /><AdSlot placement="before-faq" /></div><div class="wrap"><AdSlot placement="before-faq"/></div><section class="seo-faq"><div class="wrap"><div class="eyebrow">DOBRÉ VĚDĚT</div><h2>Časté otázky</h2><div class="faq-list">{questions.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div><a class="text-link" href="/kalkulacka-ciste-mzdy/">Další kalkulačka: mzda vs. OSVČ <span>↗</span></a></div></section></main><footer class="site-footer"><div class="wrap footer-main"><a class="brand footer-brand" href="/"><img class="brand-logo" src="/logo.svg" alt="Výdajník.cz" /></a><p>Pomáháme vidět skutečná čísla za každodenními rozhodnutími.</p><div class="footer-links"><a href="/kalkulacka-ciste-mzdy/">Kalkulačka příjmů</a><a href="/#o-nas">O projektu</a><a href="/#faq">Soukromí</a></div></div><div class="wrap footer-bottom"><span>© 2026 Výdajník.cz</span><span>Orientační výpočty nepředstavují finanční poradenství.</span><span>Česko <i>✳</i></span></div></footer><ConsentManager /><Analytics /><AdSlot placement="sticky-mobile"/><AdSlot placement="footer"/></body></html>
