---
import PartnerCard from './PartnerCard.astro';
import type { ProductOffer, ProductCategory } from '../types/monetization';
interface Props { category: ProductCategory; calculator: string; title?: string; offers?: ProductOffer[]; }
const { category, calculator, title = 'Partnerské možnosti', offers = [] } = Astro.props;
const activeOffers = offers.filter((offer) => offer.active && offer.category === category);
---
<section class="product-comparison" aria-labelledby={`comparison-${category}`} data-comparison-category={category} data-calculator={calculator}>
	<div class="comparison-heading"><div><span class="eyebrow">MOŽNOSTI OD PARTNERŮ</span><h2 id={`comparison-${category}`}>{title}</h2></div><span class="comparison-note">Nabídky se řadí podle parametrů a dostupnosti.</span></div>
	{activeOffers.length ? <div class="comparison-grid">{activeOffers.map((offer) => <PartnerCard offer={offer} calculator={calculator} />)}</div> : <><div class="comparison-grid" data-product-list></div><div class="comparison-empty" data-empty-state><span>Partnerská nabídka</span><b>Porovnání právě připravujeme.</b><p>Konkrétní ceny a podmínky zobrazíme až po napojení ověřeného poskytovatele. Žádné orientační nabídky si nevymýšlíme.</p><a href="/pojisteni-auto/">Jak pracujeme s nabídkami <span>↗</span></a></div></>}
</section>

<script>
	import { hasConsent } from '../lib/analytics-client';
	interface Offer { id:string; partnerId:string; providerName:string; registrationUrl:string|null; productName:string; priceAmount:number|null; priceCurrency:string; pricePeriod:string|null; indicativePrice:boolean; updatedAt:string|null; excess:string|null; coverage:string[]; termsUrl:string|null; affiliatePath:string; sponsored:boolean; }
	document.querySelectorAll<HTMLElement>('[data-comparison-category]').forEach(async(section)=>{
		const category=section.dataset.comparisonCategory||'';const response=await fetch(`/api/products?category=${encodeURIComponent(category)}`).catch(()=>null);if(!response?.ok)return;
		const payload=await response.json() as {offers:Offer[]};if(!payload.offers?.length)return;
		const list=section.querySelector<HTMLElement>('[data-product-list]');const empty=section.querySelector<HTMLElement>('[data-empty-state]');if(!list)return;empty?.setAttribute('hidden','');
		for(const offer of payload.offers){const card=document.createElement('article');card.className='partner-card';card.dataset.sponsored=String(offer.sponsored);const head=document.createElement('div');head.className='partner-card-head';const mark=document.createElement('span');mark.className='partner-mark';mark.textContent=offer.providerName.slice(0,1).toUpperCase();const brand=document.createElement('div');const label=document.createElement('span');label.className='partner-label';label.textContent=offer.sponsored?'Sponzorovaná partnerská nabídka':'Partnerská nabídka';const title=document.createElement('h3');title.textContent=offer.providerName;brand.append(label,title);head.append(mark,brand);card.append(head);if(offer.registrationUrl){const registration=document.createElement('a');registration.className='partner-detail';registration.href=offer.registrationUrl;registration.target='_blank';registration.rel='noopener noreferrer';registration.textContent='Ověření poskytovatele';card.append(registration);}
			const product=document.createElement('p');product.className='partner-product';product.textContent=offer.productName;card.append(product);const price=document.createElement('strong');price.className='partner-price';price.textContent=offer.priceAmount==null?'Cena se zobrazí u partnera':`${offer.indicativePrice?'Orientačně ':''}${Math.round(offer.priceAmount).toLocaleString('cs-CZ')} ${offer.priceCurrency}${offer.pricePeriod==='month'?' / měsíc':offer.pricePeriod==='year'?' / rok':''}`;card.append(price);
			if(offer.updatedAt){const updated=document.createElement('p');updated.className='partner-updated';updated.textContent=`Cena aktualizována ${new Date(offer.updatedAt).toLocaleDateString('cs-CZ')}`;card.append(updated);}if(offer.excess){const excess=document.createElement('p');excess.className='partner-detail';excess.textContent=`Spoluúčast: ${offer.excess}`;card.append(excess);}if(offer.coverage?.length){const ul=document.createElement('ul');offer.coverage.forEach(value=>{const li=document.createElement('li');li.textContent=value;ul.append(li);});card.append(ul);}
			if(offer.termsUrl){const terms=document.createElement('a');terms.className='partner-updated';terms.href=offer.termsUrl;terms.target='_blank';terms.rel='noopener noreferrer';terms.textContent='Podmínky nabídky';card.append(terms);}const link=document.createElement('a');link.className='partner-cta';link.href=`${offer.affiliatePath}?calculator=${encodeURIComponent(section.dataset.calculator||'')}`;link.rel='sponsored nofollow';link.textContent='Zobrazit nabídku ↗';link.addEventListener('click',(event)=>{event.preventDefault();const url=new URL(link.href);if(hasConsent('marketing'))url.searchParams.set('track','1');location.assign(url);});card.append(link);const disclosure=document.createElement('p');disclosure.className='partner-disclosure';disclosure.textContent='Výdajník může získat odměnu, pokud přejdete k partnerovi. Placené umístění neznamená, že jde o nejlepší nabídku.';card.append(disclosure);list.append(card);
		}
	});
</script>

<style>
	.product-comparison{padding:29px;background:#f0f4fa;border:1px solid #e3e9f1;border-radius:5px}.comparison-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:19px}.comparison-heading h2{font-size:21px;letter-spacing:-.7px;margin:7px 0 0}.comparison-note{font-size:8px;color:#8793a3}.comparison-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}.comparison-empty{padding:18px;background:white;border:1px dashed #d7dee8;max-width:560px}.comparison-empty>span{display:block;font:8px Arial,sans-serif;letter-spacing:.05em;text-transform:uppercase;color:#758399}.comparison-empty b{display:block;font-size:12px;margin-top:9px}.comparison-empty p{font-size:9px;line-height:1.6;color:#7f8b9a;max-width:420px}.comparison-empty a{font-size:9px;font-weight:600;color:#2864dc}.comparison-empty a span{margin-left:8px}
	@media(max-width:640px){.product-comparison{padding:18px}.comparison-heading{align-items:start;flex-direction:column}.comparison-heading h2{font-size:19px}}
</style>
