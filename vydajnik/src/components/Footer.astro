<script>
  type TcfUi = (command: string, version: number, callback: (value: unknown, success: boolean) => void) => void;
  declare global { interface Window { __tcfapi?: TcfUi } }
  const button = document.querySelector<HTMLButtonElement>(".consent-settings");
  const update = () => { if (button && window.__tcfapi) button.hidden = false; };
  update();
  const timer = window.setInterval(() => { if (window.__tcfapi) { update(); window.clearInterval(timer); } }, 250);
  window.setTimeout(() => window.clearInterval(timer), 8000);
  button?.addEventListener("click", () => window.__tcfapi?.("displayConsentUi", 2, () => undefined));
</script>
